# PostgreSQL Database Configuration
# 아래 설정을 .env 파일로 복사하여 사용하세요

# ============================================================
# Option 1: Docker 로컬 환경 (기본값)
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ddoksori
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================================
# Option 2: AWS RDS 환경 (팀 프로젝트 권장)
# ============================================================
# DB_HOST=ddoksori-postgres.XXXXX.ap-northeast-2.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=ddoksori
# DB_USER=postgres
# DB_PASSWORD=YOUR_STRONG_PASSWORD

# ============================================================
# API Keys (필요 시)
# ============================================================
# OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================
# Search API URL (테스트 스크립트용)
# ============================================================
# 로컬 테스트 (기본값)
# SEARCH_API_URL=http://localhost:8000

# EC2 배포 시 (공개 IP 또는 도메인으로 변경)
# SEARCH_API_URL=http://your-ec2-public-ip:8000
# SEARCH_API_URL=https://api.ddoksori.com
